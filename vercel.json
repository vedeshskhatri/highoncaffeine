{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/(health|simulate|optimize|sensitivity|retrofit|what-if|compare|annual_scan|forecast_watch|materials|validation|datasets|provenance|engineering_report|estate|sites|alerts|programme|forecast|designs|suggest-materials|location|surrogate|api)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!assets/|favicon.*|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
